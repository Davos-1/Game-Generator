---
/**
 * Gratis-Beispiel als PDF. Der einzige Download ohne Zahlung: festes Rätsel,
 * nicht personalisiert, aber mit Lösung und im gewählten Themen-Design.
 */
import { examplePdfPath, type ExampleKind } from '@/content/examples';
import { t } from '@/i18n';

interface Props {
  kind: ExampleKind;
  themeId?: string;
}

const { kind, themeId } = Astro.props;
const href = examplePdfPath(kind, themeId ?? 'neutral');
---

<div class="rounded-group border border-line bg-surface p-4 sm:flex sm:items-center sm:gap-4">
  <a
    class="inline-flex shrink-0 rounded-sheet border border-line-strong px-4 py-2 text-sm font-semibold whitespace-nowrap text-brand-700 transition-colors hover:border-accent-deep"
    href={href}
    download
  >
    {t('example.download')}
  </a>
  <p class="mt-2 text-sm text-muted sm:mt-0">{t('example.hint')}</p>
</div>

---
interface Props {
  title: string;
  updated?: string;
}
const { title, updated } = Astro.props;
---

<article class="mx-auto max-w-2xl">
  <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
  {updated && <p class="mt-2 text-sm text-slate-500">Stand: {updated}</p>}
  <div
    class="mt-8 space-y-4 text-slate-700 [&_a]:text-brand-700 [&_a]:underline [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-slate-900 [&_h3]:mt-6 [&_h3]:font-semibold [&_h3]:text-slate-900 [&_li]:ml-5 [&_li]:list-disc [&_ul]:space-y-1"
  >
    <slot />
  </div>
</article>

---
/**
 * Textseiten (Impressum, AGB, Datenschutz). Bringt die Spaltenbreite selbst
 * mit, weil `main` seit dem Umbau keine Innenabstände mehr setzt: die
 * Abschnitte gliedern die Seite und reichen bis an den Rand.
 */
interface Props {
  title: string;
  updated?: string;
}
const { title, updated } = Astro.props;
---

<article class="mx-auto max-w-2xl px-4 py-12">
  <h1 class="text-headline font-extrabold">{title}</h1>
  {updated && <p class="mt-2 text-sm text-muted">Stand: {updated}</p>}
  <div
    class="mt-8 space-y-4 text-ink [&_a]:text-brand-700 [&_a]:underline [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-bold [&_h3]:mt-6 [&_h3]:font-semibold [&_li]:ml-5 [&_li]:list-disc [&_ul]:space-y-1"
  >
    <slot />
  </div>
</article>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookletBuilder from '@/components/BookletBuilder';
import { t } from '@/i18n';
---

<BaseLayout title={t('booklet.title')} description={t('booklet.intro')}>
  <h1 class="text-3xl font-bold tracking-tight">{t('booklet.title')}</h1>
  <p class="mt-2 max-w-2xl text-slate-600">{t('booklet.intro')}</p>
  <div class="mt-8">
    <BookletBuilder client:load />
  </div>
</BaseLayout>

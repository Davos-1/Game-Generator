---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PuzzleGenerator from '@/components/PuzzleGenerator';
import {
  allLandingPages,
  copy,
  KIND_SLUG,
  relatedPages,
  type LandingPage,
} from '@/content/landing';
import { previewSvg } from '@/lib/staticPreview';
import { t } from '@/i18n';

export function getStaticPaths() {
  const pages = allLandingPages();
  return pages.map((page) => ({
    params: { typ: KIND_SLUG[page.kind], slug: page.slug },
    props: { page, all: pages },
  }));
}

interface Props {
  page: LandingPage;
  all: LandingPage[];
}

const { page, all } = Astro.props;
const type = copy.puzzleTypes[page.kind];
const theme = page.themeId ? copy.themes[page.themeId as keyof typeof copy.themes] : undefined;
const occasion = page.occasionId ? copy.occasions[page.occasionId] : undefined;
const faq = [...copy.faq[page.kind], ...copy.faq.general];
const related = relatedPages(page, all);

// Beispielbilder beim Bauen erzeugen: echte Rätsel, kein Javascript nötig.
const previewTheme = page.themeId ?? 'neutral';
const previews = [
  previewSvg(page.kind, previewTheme, `${page.slug}-1`),
  previewSvg(page.kind, previewTheme, `${page.slug}-2`),
];

const canonical = new URL(`/${KIND_SLUG[page.kind]}/${page.slug}`, Astro.site).toString();
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((entry) => ({
        '@type': 'Question',
        name: entry.q,
        acceptedAnswer: { '@type': 'Answer', text: entry.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('site.name'), item: Astro.site?.toString() },
        {
          '@type': 'ListItem',
          position: 2,
          name: type.name,
          item: new URL(`/${KIND_SLUG[page.kind]}`, Astro.site).toString(),
        },
        { '@type': 'ListItem', position: 3, name: page.heading, item: canonical },
      ],
    },
  ],
};
---

<BaseLayout
  title={page.title}
  description={page.description}
  {...page.themeId ? { ogTheme: page.themeId } : {}}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <nav aria-label="Brotkrumen" class="text-sm text-slate-500">
    <a class="hover:text-brand-700" href="/">{t('site.name')}</a>
    <span aria-hidden="true"> › </span>
    <a class="hover:text-brand-700" href={`/${KIND_SLUG[page.kind]}`}>{type.name}</a>
  </nav>

  <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{page.heading}</h1>
  <p class="mt-4 max-w-2xl text-lg text-slate-600">{page.description}</p>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    {
      previews.map((svg, index) => (
        <figure class="rounded-xl border border-slate-200 bg-white p-4">
          <div set:html={svg} />
          <figcaption class="mt-3 text-sm text-slate-500">
            {index === 0 ? t('landing.exampleA') : t('landing.exampleB')}
          </figcaption>
        </figure>
      ))
    }
  </div>

  <section class="mt-12 max-w-2xl space-y-4 text-slate-700">
    <p>{type.intro}</p>
    {theme && <p>{theme.flavour}</p>}
    {occasion && <p>{occasion.context}</p>}
  </section>

  <section class="mt-12 max-w-2xl">
    <h2 class="text-xl font-semibold">{t('landing.howTo')}</h2>
    <ol class="mt-4 space-y-2 text-slate-700">
      {
        type.howTo.map((step, index) => (
          <li class="flex gap-3">
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-sm font-semibold text-brand-700">
              {index + 1}
            </span>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold">{t('landing.createNow')}</h2>
    <div class="mt-6">
      <PuzzleGenerator
        kind={page.kind}
        {...page.themeId ? { theme: page.themeId } : {}}
        client:load
      />
    </div>
  </section>

  <section class="mt-12 max-w-2xl">
    <h2 class="text-xl font-semibold">{t('landing.tips')}</h2>
    <ul class="mt-4 space-y-2 text-slate-700">
      {type.tips.map((tip) => <li class="ml-5 list-disc">{tip}</li>)}
    </ul>
  </section>

  <section class="mt-12 max-w-2xl">
    <h2 class="text-xl font-semibold">{t('landing.faq')}</h2>
    <dl class="mt-4 space-y-5">
      {
        faq.map((entry) => (
          <div>
            <dt class="font-medium text-slate-900">{entry.q}</dt>
            <dd class="mt-1 text-slate-700">{entry.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    related.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xl font-semibold">{t('landing.related')}</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {related.map((other) => (
            <li>
              <a
                class="inline-block rounded-full border border-slate-300 px-3 py-1.5 text-sm hover:border-brand-500 hover:text-brand-700"
                href={`/${KIND_SLUG[other.kind]}/${other.slug}`}
              >
                {other.heading}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PuzzleGenerator from '@/components/PuzzleGenerator';
import ExampleDownload from '@/components/ExampleDownload.astro';
import Section from '@/components/Section.astro';
import Icon from '@/components/Icon.astro';
import { themeById } from '@raetselheft/render/themes';
import {
  allLandingPages,
  copy,
  KIND_SLUG,
  relatedPages,
  type LandingPage,
} from '@/content/landing';
import { previewSvg } from '@/lib/staticPreview';
import { t } from '@/i18n';

export function getStaticPaths() {
  const pages = allLandingPages();
  return pages.map((page) => ({
    params: { typ: KIND_SLUG[page.kind], slug: page.slug },
    props: { page, all: pages },
  }));
}

interface Props {
  page: LandingPage;
  all: LandingPage[];
}

const { page, all } = Astro.props;
const type = copy.puzzleTypes[page.kind];
const theme = page.themeId ? copy.themes[page.themeId as keyof typeof copy.themes] : undefined;
const occasion = page.occasionId ? copy.occasions[page.occasionId] : undefined;
const faq = [...copy.faq[page.kind], ...copy.faq.general];
const related = relatedPages(page, all);

// Beispielbilder beim Bauen erzeugen: echte Rätsel, kein Javascript nötig.
const previewTheme = page.themeId ?? 'neutral';
const previews = [
  previewSvg(page.kind, previewTheme, `${page.slug}-1`),
  previewSvg(page.kind, previewTheme, `${page.slug}-2`),
];

const canonical = new URL(`/${KIND_SLUG[page.kind]}/${page.slug}`, Astro.site).toString();

// Die Seite übernimmt die Palette ihres Themes: ein Mechanismus, fünf
// Farbwelten. Ohne Theme bleibt es beim Akzent der Website.
const palette = themeById(previewTheme).colors;
const themeStyle = page.themeId
  ? `--color-accent-deep:${palette.accent};--color-line-strong:${palette.grid}`
  : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((entry) => ({
        '@type': 'Question',
        name: entry.q,
        acceptedAnswer: { '@type': 'Answer', text: entry.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('site.name'), item: Astro.site?.toString() },
        {
          '@type': 'ListItem',
          position: 2,
          name: type.name,
          item: new URL(`/${KIND_SLUG[page.kind]}`, Astro.site).toString(),
        },
        { '@type': 'ListItem', position: 3, name: page.heading, item: canonical },
      ],
    },
  ],
};
---

<BaseLayout
  title={page.title}
  description={page.description}
  {...page.themeId ? { ogTheme: page.themeId } : {}}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <Section ground="hero" space="normal">
    <nav aria-label="Brotkrumen" class="text-sm text-hero-muted">
      <a class="hover:text-hero-ink" href="/">{t('site.name')}</a>
      <span aria-hidden="true"> › </span>
      <a class="hover:text-hero-ink" href={`/${KIND_SLUG[page.kind]}`}>{type.name}</a>
    </nav>

    <h1 class="mt-3 text-display font-extrabold">{page.heading}</h1>
    <p class="mt-4 max-w-2xl text-lg text-hero-muted">{page.description}</p>
    {
      theme && (
        <p class="mt-5 inline-flex items-center gap-2 text-sm text-hero-muted">
          <Icon
            name={themeById(previewTheme).icons.cover}
            size={18}
            style={`color:${palette.decor}`}
          />
          {theme.name}
        </p>
      )
    }
  </Section>

  <div style={themeStyle}>
    <Section ground="paper">
      <div class="grid gap-6 sm:grid-cols-2">
        {
          previews.map((svg, index) => (
            <figure class="rounded-group border border-line bg-surface p-4">
              <div set:html={svg} />
              <figcaption class="mt-3 text-sm text-muted">
                {index === 0 ? t('landing.exampleA') : t('landing.exampleB')}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </Section>

    <Section ground="surface">
      <div class="max-w-2xl space-y-4">
        <p>{type.intro}</p>
        {theme && <p>{theme.flavour}</p>}
        {occasion && <p>{occasion.context}</p>}
      </div>

      <div class="mt-12 max-w-2xl">
        <h2 class="text-xl font-bold">{t('landing.howTo')}</h2>
        <ol class="mt-4 space-y-2">
          {
            type.howTo.map((step, index) => (
              <li class="flex gap-3">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-line-strong text-sm font-semibold">
                  {index + 1}
                </span>
                <span>{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </Section>

    <Section ground="paper">
      <h2 class="text-xl font-bold">{t('landing.createNow')}</h2>
      <div class="mt-6 max-w-2xl">
        <ExampleDownload kind={page.kind} {...page.themeId ? { themeId: page.themeId } : {}} />
      </div>
      <div class="mt-6">
        <PuzzleGenerator
          kind={page.kind}
          {...page.themeId ? { theme: page.themeId } : {}}
          client:load
        />
      </div>
    </Section>

    <Section ground="surface">
      <div class="max-w-2xl">
        <h2 class="text-xl font-bold">{t('landing.tips')}</h2>
        <ul class="mt-4 space-y-2">
          {type.tips.map((tip) => <li class="ml-5 list-disc">{tip}</li>)}
        </ul>

        <h2 class="mt-12 text-xl font-bold">{t('landing.faq')}</h2>
        <dl class="mt-4 space-y-5">
          {
            faq.map((entry) => (
              <div>
                <dt class="font-semibold">{entry.q}</dt>
                <dd class="mt-1 text-muted">{entry.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </Section>

    {
      related.length > 0 && (
        <Section ground="paper">
          <h2 class="text-xl font-bold">{t('landing.related')}</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {related.map((other) => (
              <li>
                <a
                  class="inline-block rounded-sheet border border-line-strong px-3 py-1.5 text-sm transition-colors hover:border-accent-deep"
                  href={`/${KIND_SLUG[other.kind]}/${other.slug}`}
                >
                  {other.heading}
                </a>
              </li>
            ))}
          </ul>
        </Section>
      )
    }
  </div>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import PuzzleGenerator from '@/components/PuzzleGenerator';
import ExampleDownload from '@/components/ExampleDownload.astro';
import { copy } from '@/content/landing';
import { t } from '@/i18n';

const type = copy.puzzleTypes['dot-to-dot'];
---

<BaseLayout title={t('nav.dotToDot')} description={type.short}>
  <Section ground="hero" space="normal">
    <h1 class="text-headline font-extrabold">{t('nav.dotToDot')}</h1>
    <p class="mt-3 max-w-2xl text-hero-muted">{type.short}</p>
  </Section>

  <Section ground="paper" space="tight">
    <div class="max-w-2xl">
      <ExampleDownload kind="dot-to-dot" />
    </div>
  </Section>

  <Section ground="paper" space="tight">
    <PuzzleGenerator kind="dot-to-dot" client:load />
  </Section>
</BaseLayout>

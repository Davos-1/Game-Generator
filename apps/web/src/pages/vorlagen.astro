---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import { allLandingPages, copy, KIND_SLUG, PUZZLE_KINDS } from '@/content/landing';
import { t } from '@/i18n';

const pages = allLandingPages();
---

<BaseLayout title={t('landing.allPages')} description={t('landing.allPagesIntro')}>
  <Section ground="hero" space="normal">
    <h1 class="text-headline font-extrabold">{t('landing.allPages')}</h1>
    <p class="mt-3 max-w-2xl text-hero-muted">{t('landing.allPagesIntro')}</p>
  </Section>

  {
    PUZZLE_KINDS.map((kind, index) => (
      <Section ground={index % 2 === 0 ? 'paper' : 'surface'}>
        <h2 class="text-lg font-bold">
          <a class="text-brand-700 hover:underline" href={`/${KIND_SLUG[kind]}`}>
            {copy.puzzleTypes[kind].name}
          </a>
        </h2>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {pages
            .filter((page) => page.kind === kind)
            .map((page) => (
              <li>
                <a
                  class="block rounded-sheet border border-line bg-surface px-3 py-2 text-sm transition-colors hover:border-accent-deep"
                  href={`/${KIND_SLUG[kind]}/${page.slug}`}
                >
                  {page.heading}
                </a>
              </li>
            ))}
        </ul>
      </Section>
    ))
  }
</BaseLayout>

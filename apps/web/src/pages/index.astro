---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';

const cards = [
  { href: '/wortsuchraetsel', label: t('nav.wordsearch'), text: t('home.cards.wordsearch') },
  { href: '/labyrinth', label: t('nav.maze'), text: t('home.cards.maze') },
  { href: '/sudoku', label: t('nav.sudoku'), text: t('home.cards.sudoku') },
];
---

<BaseLayout title={t('site.tagline')}>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('home.title')}</h1>
  <p class="mt-4 max-w-2xl text-lg text-slate-600">{t('home.intro')}</p>

  <div class="mt-10 grid gap-4 sm:grid-cols-3">
    {
      cards.map((card) => (
        <a
          href={card.href}
          class="rounded-xl border border-slate-200 p-5 transition hover:border-brand-500 hover:shadow-sm"
        >
          <h2 class="text-lg font-semibold text-brand-700">{card.label}</h2>
          <p class="mt-2 text-sm text-slate-600">{card.text}</p>
        </a>
      ))
    }
  </div>
  <div class="mt-10 rounded-xl border border-brand-500/30 bg-brand-50 p-5">
    <h2 class="text-lg font-semibold text-brand-700">{t('booklet.title')}</h2>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">{t('booklet.intro')}</p>
    <a
      href="/raetselheft"
      class="mt-4 inline-block rounded-lg bg-brand-500 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
    >
      {t('booklet.title')}
    </a>
  </div>

  <p class="mt-6 text-sm text-slate-500">{t('home.status')}</p>
</BaseLayout>

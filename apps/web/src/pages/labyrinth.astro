---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PuzzleGenerator from '@/components/PuzzleGenerator';
import ExampleDownload from '@/components/ExampleDownload.astro';
import { copy } from '@/content/landing';
import { t } from '@/i18n';
---

<BaseLayout title={t('nav.maze')} description={copy.puzzleTypes.maze.short}>
  <h1 class="text-3xl font-bold tracking-tight">{t('nav.maze')}</h1>
  <p class="mt-2 max-w-2xl text-slate-600">{copy.puzzleTypes.maze.short}</p>
  <div class="mt-6 max-w-2xl">
    <ExampleDownload kind="maze" />
  </div>
  <div class="mt-8">
    <PuzzleGenerator kind="maze" client:load />
  </div>
</BaseLayout>

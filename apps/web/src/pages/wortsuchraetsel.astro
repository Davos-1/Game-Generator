---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import PuzzleGenerator from '@/components/PuzzleGenerator';
import ExampleDownload from '@/components/ExampleDownload.astro';
import { copy } from '@/content/landing';
import { t } from '@/i18n';
---

<BaseLayout title={t('nav.wordsearch')} description={copy.puzzleTypes.wordsearch.short}>
  <Section ground="hero" space="normal">
    <h1 class="text-headline font-extrabold">{t('nav.wordsearch')}</h1>
    <p class="mt-3 max-w-2xl text-hero-muted">{copy.puzzleTypes.wordsearch.short}</p>
  </Section>

  <Section ground="paper" space="tight">
    <div class="max-w-2xl">
      <ExampleDownload kind="wordsearch" />
    </div>
  </Section>

  <Section ground="paper" space="tight">
    <PuzzleGenerator kind="wordsearch" client:load />
  </Section>
</BaseLayout>

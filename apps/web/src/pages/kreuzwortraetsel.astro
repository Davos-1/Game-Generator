---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import PuzzleGenerator from '@/components/PuzzleGenerator';
import ExampleDownload from '@/components/ExampleDownload.astro';
import { copy } from '@/content/landing';
import { t } from '@/i18n';

const type = copy.puzzleTypes.crossword;
---

<BaseLayout title={t('nav.crossword')} description={type.short}>
  <Section ground="hero" space="normal">
    <h1 class="text-headline font-extrabold">{t('nav.crossword')}</h1>
    <p class="mt-3 max-w-2xl text-hero-muted">{type.short}</p>
  </Section>

  <Section ground="paper" space="tight">
    <div class="max-w-2xl">
      <ExampleDownload kind="crossword" />
    </div>
  </Section>

  <Section ground="paper" space="tight">
    <PuzzleGenerator kind="crossword" client:load />
  </Section>
</BaseLayout>

---
import '@/styles/global.css';
import { t, DEFAULT_LOCALE } from '@/i18n';
import { isActive } from '@/lib/nav';
import Icon from '@/components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  /** Theme der Seite; bestimmt das Vorschaubild beim Teilen. */
  ogTheme?: string;
}

const { title, description = t('site.description'), ogTheme } = Astro.props;
const OG_THEMES = ['piraten', 'einhorn', 'dschungel', 'hochzeit', 'weihnachten'];
const ogImage = new URL(
  `/og/${ogTheme && OG_THEMES.includes(ogTheme) ? ogTheme : 'default'}.png`,
  Astro.site,
);
const analyticsToken = import.meta.env.PUBLIC_ANALYTICS_TOKEN ?? '';
// build.format = «file» hängt .html an; die öffentlichen Adressen sind ohne.
// Ohne diese Bereinigung zeigte die kanonische Adresse auf eine andere URL als
// alle internen Links und die Sitemap.
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(cleanPath, Astro.site);

const NAV = [
  { href: '/wortsuchraetsel', label: t('nav.wordsearch') },
  { href: '/labyrinth', label: t('nav.maze') },
  { href: '/sudoku', label: t('nav.sudoku') },
];
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t('site.name')}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/BricolageGrotesque-Latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    {
      /* Cloudflare Web Analytics: ohne Cookies, daher kein Banner nötig.
         Das Kennzeichen wird beim Bauen gesetzt; ohne Kennzeichen kein Skript. */
    }
    {
      analyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${analyticsToken}"}`}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-20 bg-hero text-hero-ink">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
      >
        <a href="/" class="flex items-center gap-2 font-display text-xl font-extrabold">
          <Icon name="sparkle" size={24} class="text-accent" />
          {t('site.name')}
        </a>
        {/* Umbricht auf schmalen Bildschirmen; vier Links passen sonst nicht nebeneinander. */}
        <nav class="-mx-2 flex flex-wrap items-center gap-x-1 gap-y-0 text-sm">
          {
            NAV.map((entry) => (
              <a
                href={entry.href}
                aria-current={isActive(cleanPath, entry.href) ? 'page' : undefined}
                class:list={[
                  'rounded-sheet px-2 py-2 transition-colors',
                  isActive(cleanPath, entry.href)
                    ? 'font-semibold text-hero-ink shadow-[inset_0_-2px_0_var(--color-accent)]'
                    : 'text-hero-muted hover:text-hero-ink',
                ]}
              >
                {entry.label}
              </a>
            ))
          }
          <a
            class="ml-1 rounded-sheet bg-accent px-3 py-2 font-semibold text-accent-ink transition-colors hover:bg-accent-deep hover:text-white"
            href="/raetselheft">{t('nav.booklet')}</a
          >
        </nav>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-line bg-surface text-sm text-muted">
      <div class="mx-auto grid max-w-5xl gap-6 px-4 py-8 sm:grid-cols-3">
        <div class="flex flex-col gap-2">
          <span class="font-display text-base font-bold text-ink">{t('site.name')}</span>
          <span>{t('site.tagline')}</span>
        </div>
        <nav class="flex flex-col gap-1">
          <span class="text-xs font-semibold tracking-widest text-ink uppercase">
            {t('footer.puzzles')}
          </span>
          {
            NAV.map((entry) => (
              <a class="py-0.5 hover:text-brand-700" href={entry.href}>
                {entry.label}
              </a>
            ))
          }
        </nav>
        <nav class="flex flex-col gap-1">
          <span class="text-xs font-semibold tracking-widest text-ink uppercase">
            {t('footer.legal')}
          </span>
          <a class="py-0.5 hover:text-brand-700" href="/vorlagen">{t('footer.templates')}</a>
          <a class="py-0.5 hover:text-brand-700" href="/impressum">{t('footer.imprint')}</a>
          <a class="py-0.5 hover:text-brand-700" href="/datenschutz">{t('footer.privacy')}</a>
          <a class="py-0.5 hover:text-brand-700" href="/agb">{t('footer.terms')}</a>
        </nav>
      </div>
      <div class="mx-auto max-w-5xl px-4 pb-6 text-xs">
        © {new Date().getFullYear()}
        {t('site.name')}
      </div>
    </footer>
  </body>
</html>

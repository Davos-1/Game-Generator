---
import '@/styles/global.css';
import { t, DEFAULT_LOCALE } from '@/i18n';

interface Props {
  title: string;
  description?: string;
  /** Theme der Seite; bestimmt das Vorschaubild beim Teilen. */
  ogTheme?: string;
}

const { title, description = t('site.description'), ogTheme } = Astro.props;
const OG_THEMES = ['piraten', 'einhorn', 'dschungel', 'hochzeit', 'weihnachten'];
const ogImage = new URL(
  `/og/${ogTheme && OG_THEMES.includes(ogTheme) ? ogTheme : 'default'}.png`,
  Astro.site,
);
const analyticsToken = import.meta.env.PUBLIC_ANALYTICS_TOKEN ?? '';
// build.format = «file» hängt .html an; die öffentlichen Adressen sind ohne.
// Ohne diese Bereinigung zeigte die kanonische Adresse auf eine andere URL als
// alle internen Links und die Sitemap.
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(cleanPath, Astro.site);
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t('site.name')}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    {
      /* Cloudflare Web Analytics: ohne Cookies, daher kein Banner nötig.
         Das Kennzeichen wird beim Bauen gesetzt; ohne Kennzeichen kein Skript. */
    }
    {
      analyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${analyticsToken}"}`}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-slate-200">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:py-4"
      >
        <a href="/" class="text-xl font-bold tracking-tight text-brand-700">{t('site.name')}</a>
        {/* Umbricht auf schmalen Bildschirmen; vier Links passen sonst nicht nebeneinander. */}
        <nav class="-mx-2 flex flex-wrap items-center gap-x-2 gap-y-0 text-sm text-slate-600">
          <a class="rounded px-2 py-2 hover:text-brand-700" href="/wortsuchraetsel"
            >{t('nav.wordsearch')}</a
          >
          <a class="rounded px-2 py-2 hover:text-brand-700" href="/labyrinth">{t('nav.maze')}</a>
          <a class="rounded px-2 py-2 hover:text-brand-700" href="/sudoku">{t('nav.sudoku')}</a>
          <a
            class="rounded px-2 py-2 font-medium text-brand-700 hover:underline"
            href="/raetselheft">{t('nav.booklet')}</a
          >
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-12">
      <slot />
    </main>
    <footer class="border-t border-slate-200 text-sm text-slate-500">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-4 gap-y-1 px-4 py-5">
        <span>© {new Date().getFullYear()} {t('site.name')}</span>
        <a class="rounded py-2 hover:text-brand-700" href="/vorlagen">{t('footer.templates')}</a>
        <a class="rounded py-2 hover:text-brand-700" href="/impressum">{t('footer.imprint')}</a>
        <a class="rounded py-2 hover:text-brand-700" href="/datenschutz">{t('footer.privacy')}</a>
        <a class="rounded py-2 hover:text-brand-700" href="/agb">{t('footer.terms')}</a>
      </div>
    </footer>
  </body>
</html>

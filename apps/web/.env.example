# Adresse des Zahlungs-Workers, z. B. https://raetselheft-payment.<konto>.workers.dev
# Leer oder nicht gesetzt: der Kauf ist abgeschaltet, es gibt nur die Vorschau.
PUBLIC_PAYMENT_API=

# Cloudflare Web Analytics: Kennzeichen aus dem Dashboard.
# Leer oder nicht gesetzt: es wird kein Statistik-Skript geladen.
PUBLIC_ANALYTICS_TOKEN=

{
  "name": "@raetselheft/render",
  "version": "0.1.0",
  "private": true,
  "description": "Layout-Schicht: Rätsel → Layout-Primitive → SVG-Vorschau und PDF-Export (eine Quelle der Wahrheit)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./fonts/*": "./fonts/*",
    "./*": "./src/*.ts",
    "./metrics.json": "./src/metrics.json"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples": "vite-node scripts/generate-samples.ts",
    "metrics": "vite-node scripts/generate-metrics.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@raetselheft/engine": "workspace:*",
    "fontkit": "^2.0.4",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.11"
  }
}
